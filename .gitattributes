# CI runs the same bash steps on Linux, macOS and Windows runners, so line endings are
# normalised rather than left to the checkout platform.
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.onnx binary
*.parquet binary

# Licence texts kept byte for byte as their publisher ships them, so each one's SHA-256 in
# third-party/README.md is the publisher's file and not a copy with its line endings changed.
third-party/onnxruntime/** -text
third-party/directml/** -text
