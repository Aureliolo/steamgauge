# This repository is public and holds no review data. Anything pulled from Steam stays
# local: it is large, it is reproducible from the app ID, and it is not ours to
# redistribute.
data/

# Drawn reference samples carry the review text itself, unlike the labels beside them,
# which name reviews by id only. `steamgauge sample` regenerates these from the corpus and
# the seed recorded in the manifest, so nothing is lost by keeping them out.
reference/**/sample.json
reference/**/batches/
# What a labeller hands back, before the ingest checks it against the draw and writes
# `labels.json`. Every field survives the merge, so the accepted labelling is the record and
# these are the working copy it was built from.
reference/**/returned/
# The diverse handouts carry review text too; the subjects induced from them do not.
reference/distinct/*.json
corpus/
raw/

# Rendered reports quote review text, which is the same reason the captures are not here.
steamgauge-report.html
*-report.html
# The adjudication page carries the review around every claim, for the same reason.
gold.html
*-gold.html
gold-answers.json
# Answers set aside to be asked again under amended wording, kept beside the file so the second
# answer can be read against the first. Adjudications, like the page, are never committed.
gold-reask.json
analysis/
output/
*.db
*.db-wal
*.db-shm
*.parquet
*.jsonl
*.csv

# Credentials. Never commit any of these.
.env
.env.*
*.key
*_api_key
.steam_api_key
secrets.*
credentials.*

# Embedding models are fetched on first run and verified by checksum.
models/
*.onnx
# The weights of a reader too large for one protobuf, which sit beside its graph.
*.onnx.data

# Training data carries review text, for the same reason the captures are not here. The
# label set beside it names claims by review id and byte offset and is committed.
training/data/
# What a run produced. Its metrics and config are committed as a summary; the weights,
# checkpoints and logs are not, because a model belongs on Hugging Face with a card.
training/runs/*/checkpoints/
training/runs/*/backbone/
training/runs/*/*.bin
training/runs/*/*.safetensors
training/runs/*/*.onnx
# A tokenizer is seventeen megabytes and is reproducible from the backbone name recorded in
# run.json, so it belongs with the published model rather than in the history. Both the
# directory the trainer saves and the copy the export lays beside the graph.
training/runs/*/tokenizer/
training/runs/*/tokenizer.json
training/.venv/

# Build and dependency artefacts
# tauri-build writes its capability schemas beside the manifest on every build, and a different
# set on each platform: tracked, a release build on Linux or macOS would find the tree it was
# built from changed underneath it.
crates/steamgauge-app/gen/schemas/
target/
target-*/
dist/
build/
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
