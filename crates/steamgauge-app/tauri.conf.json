{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamGauge",
  "mainBinaryName": "steamgauge",
  "identifier": "com.aureliolo.steamgauge",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SteamGauge",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Aurelio Amoroso",
    "copyright": "Copyright (c) 2026 Aurelio Amoroso",
    "category": "Utility",
    "shortDescription": "Finds out what players of a game think, from every Steam review.",
    "longDescription": "SteamGauge downloads a game's Steam reviews, reads every claim in them with a model on your own machine, and shows what players praise and criticise, with the reviews behind every figure.",
    "homepage": "https://github.com/Aureliolo/steamgauge",
    "license": "Apache-2.0",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "template": "installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
