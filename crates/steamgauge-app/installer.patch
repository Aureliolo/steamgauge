--- installer.nsi
+++ installer.nsi
@@ -241,6 +241,10 @@
     !insertmacro MUI_HEADER_TEXT "$(alreadyInstalled)" "$(chooseMaintenanceOption)"
   ; Upgrading
   ${ElseIf} $R0 = 1
+    ; SteamGauge: an upgrade installs over the older copy, as Tauri's own updater does with
+    ; /UPDATE, and this page is skipped. Its default runs the old uninstaller first, whose page
